# Compiled Python.
__pycache__/
*.pyc

# Virtual environments.
/.venv

# Build artifacts.
/dist

# Local staging space
# (e.g., downloaded binaries, generated files).
/.staging

# Local credentials and secrets.
/secrets/*
!/secrets/.gitkeep

# Terraform state, cache, and crash logs.
**/.terraform/
*.tfbackend
*.tfstate
*.tfstate.*
*.tfvars.json
crash.log
crash.*.log

# Terraform test fixtures apply/destroy repeatedly with loose version constraints.
# Unlike a real deployment, no reproducibility benefit to locking.
tests/**/.terraform.lock.hcl
